XIAOMI_API_KEY=
MEM0_API_KEY=
JARVIS_MODEL=mimo-v2.5
JARVIS_ASSISTANT_NAME=未命名角色
JARVIS_PORT=3030
MINIMIND_LLM_TIMEOUT_SECONDS=75
MINIMIND_MEMORY_ENABLED=0
# Recall is awaited before the Pi turn starts, so this is a direct pre-turn
# latency budget. It matches the bridge's code default; raise it only if you
# prefer slower turns in exchange for more recalled memory.
JARVIS_MEMORY_RECALL_TIMEOUT_MS=120

# Long-term writes run in the background after the spoken turn has settled.
# Mem0's add() is an async enqueue (it returns an event_id and runs extraction
# server-side), so these bound only our request round trip. Raise the cap only
# if you accept more concurrent queued writes.
JARVIS_MEMORY_SAVE_TIMEOUT_MS=10000
JARVIS_MEMORY_SAVE_MAX_PENDING=8

# Realtime voice service (Whispera). jarvis/run.ps1 and the supervisor both use
# 8111; Electron's own fallback default is upstream Whispera's 8011, so setting
# these explicitly keeps a source checkout and a bare `python -m realtime.app`
# on the same port.
MINIMIND_BACKEND_HTTP_BASE=http://127.0.0.1:8111
MINIMIND_BACKEND_WS_URL=ws://127.0.0.1:8111/ws/realtime
MINIMIND_ASR_MODE=cloud
MINIMIND_TTS_MODE=cloud

# pi-web must not create a second Pi AgentSession while the Jarvis bridge owns
# the conversation. Leave unset for Jarvis; set to 1 only for standalone pi-web.
PI_WEB_ALLOW_LOCAL_AGENT_SESSION=

JARVIS_MPV_PATH=
JARVIS_YTDLP_PATH=
JARVIS_YOUTUBE_COOKIES_FROM_BROWSER=
JARVIS_YOUTUBE_MAX_HEIGHT=720
JARVIS_WINDOWS_MCP_COMMAND=uvx
JARVIS_WINDOWS_MCP_ARGS_JSON=["--python","3.14","--from","windows-mcp==0.8.5","windows-mcp","serve"]
WINDOWS_MCP_WATCHDOG=off
ANONYMIZED_TELEMETRY=false
JARVIS_SUBAGENT_TIMEOUT_MS=300000
JARVIS_SUBAGENT_MAX_CONCURRENCY=2
JARVIS_ENVIRONMENT_MEMORY_PATH=runtime/environment-memory/events.jsonl
JARVIS_ENVIRONMENT_MEMORY_RETENTION_DAYS=30
JARVIS_REMINDERS_PATH=runtime/desktop-tools/reminders.json
JARVIS_DESKTOP_COMMAND_TIMEOUT_MS=10000
MIMO_TTS_VOICE=茉莉
MIMO_ASR_INSTRUCTION=请只输出忠实的原始语音转写，保留重复词、语气词和中英文原词，不要自行改写或总结。
MIMO_TTS_STYLE=请自然、清晰地朗读下一条助手文本。中文使用普通话；英文单词和常见技术名词使用自然英语发音，不要逐个拼读字母；中英文混合时保持语流自然。不要朗读这条指令。
